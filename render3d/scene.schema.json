{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://behinddelmundo.invalid/schemas/scene-project-v2.json",
  "title": "Behind del Mundo 3D Project v2",
  "type": "object",
  "required": [
    "version",
    "project",
    "shots"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "project": {
      "type": "object",
      "required": [
        "title",
        "fps",
        "resolution",
        "duration_seconds"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "fps": {
          "type": "integer",
          "minimum": 12,
          "maximum": 60
        },
        "resolution": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 256
            },
            {
              "type": "integer",
              "minimum": 256
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "seed": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration_seconds",
          "environment",
          "camera",
          "entities"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "environment": {
            "type": "object",
            "properties": {
              "background": {
                "type": "string"
              },
              "ambient_strength": {
                "type": "number"
              },
              "fog_density": {
                "type": "number"
              },
              "ground": {
                "type": "boolean"
              },
              "ground_material": {
                "type": "object"
              }
            },
            "additionalProperties": true
          },
          "camera": {
            "type": "object",
            "required": [
              "position",
              "target"
            ],
            "properties": {
              "position": {
                "$ref": "#/$defs/vector3"
              },
              "target": {
                "$ref": "#/$defs/vector3"
              },
              "lens_mm": {
                "type": "number"
              },
              "focal_length_mm": {
                "type": "number"
              },
              "dof": {
                "type": "boolean"
              },
              "movement": {
                "type": "array"
              }
            },
            "additionalProperties": true
          },
          "lights": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "position",
                "power"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "AREA",
                    "POINT",
                    "SUN",
                    "SPOT"
                  ]
                },
                "position": {
                  "$ref": "#/$defs/vector3"
                },
                "target": {
                  "$ref": "#/$defs/vector3"
                },
                "power": {
                  "type": "number"
                },
                "color": {
                  "type": "string"
                },
                "size": {
                  "type": "number"
                }
              },
              "additionalProperties": true
            }
          },
          "entities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "kind",
                "transform"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "primitive",
                    "curve",
                    "asset",
                    "text",
                    "mesh"
                  ]
                },
                "primitive": {
                  "enum": [
                    "UV_SPHERE",
                    "ICO_SPHERE",
                    "CUBE",
                    "CYLINDER",
                    "CONE",
                    "TORUS",
                    "PLANE"
                  ]
                },
                "asset": {
                  "type": "string"
                },
                "transform": {
                  "type": "object",
                  "properties": {
                    "location": {
                      "$ref": "#/$defs/vector3"
                    },
                    "rotation": {
                      "$ref": "#/$defs/vector3"
                    },
                    "scale": {
                      "$ref": "#/$defs/vector3"
                    }
                  },
                  "additionalProperties": true
                },
                "material": {
                  "type": "object"
                },
                "animation": {
                  "type": "array"
                },
                "details": {
                  "type": "object",
                  "description": "Primitive-specific data; mesh uses vertices/faces; curve uses points and bevel settings."
                }
              },
              "additionalProperties": true
            }
          },
          "graphics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "location"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "location": {
                  "$ref": "#/$defs/vector3"
                },
                "size": {
                  "type": "number"
                },
                "color": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    }
  },
  "additionalProperties": false
}
